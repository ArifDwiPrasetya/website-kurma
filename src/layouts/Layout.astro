---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image" href="/logo.png" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="google-site-verification"
      content="oh7V9Q-jUB-9a7lfLQ8n_Uro5pYQs8IoiBUNYuk0cWE"
    />

    <!-- Slot untuk seo -->
    <slot name="seo" />

    <title>Kurmamu</title>
  </head>
  <body>
    <slot />
    <script>
      //Setup efek scroll
      import { setupSmoothScroll } from "../scripts/scroll.js";

      // Jalankan fungsi setelah DOM siap
      setupSmoothScroll();

      // Tips: Jika Anda menggunakan View Transitions Astro, gunakan ini agar script tetap jalan saat pindah halaman:
      document.addEventListener("astro:page-load", setupSmoothScroll);
    </script>
  </body>
</html>
